{
    // @@ Usefull data
    //
    // Fonts:
    //   Cascadia Code: https://github.com/microsoft/cascadia-code
    //   CaskaydiaCove NF: https://github.com/ryanoasis/nerd-fonts/releases/latest/download/CascadiaCode.zip
    // Extensions:
    //   prasadgk.breakpoint-enhancer - very usefull to see breakpoints when "editor.glyphMargin": false,
    //
    // @@ HIDDEN SETTINGS
    //
    // For working folding when:
    // "editor.folding": true and  "editor.showFoldingControls": "never",
    "editor.lineDecorationsWidth": 18,
    // Fix long render time on minificated files
    "editor.stopRenderingLineAfter": 128,
    //
    // @@ Editor Core Settingst
    "editor.lineHeight": 1.618,
    "editor.lineNumbers": "off",
    "editor.defaultColorDecorators": "never",
    "editor.fontWeight": "normal",
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.formatOnPaste": false,
    "editor.overviewRulerBorder": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 4,
    "editor.detectIndentation": true,
    "editor.insertSpaces": true,
    "editor.rulers": [
        80
    ],
    "editor.wordWrap": "bounded",
    "editor.wrappingStrategy": "advanced",
    "editor.wordWrapColumn": 80,
    "editor.stickyTabStops": true,
    "editor.stickyScroll.maxLineCount": 7,
    "editor.fastScrollSensitivity": 5,
    "editor.mouseWheelScrollSensitivity": 2,
    "editor.cursorBlinking": "solid",
    "editor.cursorWidth": 2,
    "editor.cursorSurroundingLines": 3,
    "editor.scrollbar.verticalScrollbarSize": 12,
    "editor.accessibilitySupport": "off",
    "editor.largeFileOptimizations": true,
    "editor.autoIndentOnPaste": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.codeActions.triggerOnFocusChange": true,
    "editor.dropIntoEditor.preferences": [
        "text.plain",
        "uri.path.absolute",
        "uri.path.relative",
    ],
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.cursorHeight": 16,
    "editor.find.autoFindInSelection": "multiline",
    "editor.folding": true,
    "editor.fontVariations": true,
    "editor.hover.showLongLineWarning": false,
    "editor.glyphMargin": false,
    "editor.gotoLocation.alternativeImplementationCommand": "editor.action.goToImplementation",
    "editor.gotoLocation.alternativeReferenceCommand": "editor.action.goToReferences",
    "editor.gotoLocation.alternativeTypeDefinitionCommand": "editor.action.goToTypeDefinition",
    "editor.gotoLocation.multipleDeclarations": "gotoAndPeek",
    "editor.gotoLocation.multipleDefinitions": "gotoAndPeek",
    "editor.gotoLocation.multipleImplementations": "gotoAndPeek",
    "editor.gotoLocation.multipleReferences": "gotoAndPeek",
    "editor.gotoLocation.multipleTypeDefinitions": "gotoAndPeek",
    "editor.guides.bracketPairs": "active",
    "editor.guides.highlightActiveIndentation": "always",
    "editor.hover.delay": 0,
    "editor.hover.enabled": "onKeyboardModifier",
    "editor.hover.hidingDelay": 150,
    "editor.inertialScroll": true,
    "editor.inlineSuggest.showToolbar": "never",
    "editor.linkedEditing": true,
    "editor.minimap.enabled": false,
    "editor.overtypeCursorStyle": "underline",
    "editor.padding.bottom": 18,
    "editor.padding.top": 18,
    "editor.renderFinalNewline": "off",
    "editor.renderLineHighlight": "gutter",
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.scrollbar.ignoreHorizontalScrollbarInContentHeight": true,
    "editor.scrollBeyondLastLine": false,
    "editor.selectionHighlightMultiline": true,
    "editor.showFoldingControls": "never",
    "editor.snippetSuggestions": "top",
    "editor.stablePeek": true,
    "editor.renderWhitespace": "trailing",
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.defaultModel": "foldingProviderModel",
    "editor.stickyScroll.scrollWithEditor": false,
    "editor.unicodeHighlight.includeStrings": true,
    "editor.unicodeHighlight.allowedLocales": {
        "uk": true,
        "ru": true,
    },
    "editor.wrapOnEscapedLineFeeds": true,
    //
    // @@ Editor Font & Typography
    //
    "editor.fontSize": 15,
    "editor.fontFamily": "'Iosevka Neko Sans', 'CaskaydiaCove NF', 'Cascadia Code', 'Fira Code'",
    "editor.fontLigatures": "'liga' 1,'calt' 1",
    // "editor.fontLigatures": "'liga' 1,'calt' 1,'frac' 1",
    "editor.inlineSuggest.fontFamily": "'Iosevka Neko Sans', 'CaskaydiaCove NF', 'Cascadia Code', 'Fira Code'",
    //
    // @@ Editor Suggestions & IntelliSense & Files
    //
    "editor.acceptSuggestionOnEnter": "off",
    "editor.suggestSelection": "recentlyUsedByPrefix",
    "editor.suggest.preview": true,
    "editor.suggest.showStatusBar": true,
    "editor.suggest.showDeprecated": false,
    "editor.suggest.snippetsPreventQuickSuggestions": true,
    "editor.suggest.shareSuggestSelections": true,
    "editor.suggest.localityBonus": true,
    "editor.tabCompletion": "on",
    "editor.quickSuggestions": {
        "comments": "inline",
        "strings": "inline",
    },
    "editor.quickSuggestionsDelay": 0,
    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.screenReaderAnnounceInlineSuggestion": false,
    "emmet.showSuggestionsAsSnippets": false,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.inlayHints.padding": true,
    "files.defaultLanguage": "plaintext",
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/vendor/**": true,
    },
    "files.autoSave": "onFocusChange",
    "files.autoSaveWhenNoErrors": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.enableTrash": true,
    "files.associations": {
        "*.md": "markdown",
        "*.php": "php",
        "*.min.css": "code-text-binary",
        "*.min.js": "code-text-binary",
    },
    "files.autoGuessEncoding": true,
    "files.autoSaveWorkspaceFilesOnly": true,
    "files.insertFinalNewline": true,
    "files.simpleDialog.enable": true,
    //
    // @@ Search & Find
    //
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.git": true,
        "**/*.min.js": true,
        "**/*.min.css": true,
    },
    "search.defaultViewMode": "tree",
    "search.maxResults": 25000,
    "search.collapseResults": "auto",
    "search.showLineNumbers": true,
    "search.seedOnFocus": true,
    "search.seedWithNearestWord": true,
    "search.decorations.badges": false,
    "search.searchEditor.reusePriorSearchConfiguration": true,
    "search.searchEditor.doubleClickBehaviour": "openLocationToSide",
    "search.searchEditor.defaultNumberOfContextLines": null,
    "editor.find.addExtraSpaceOnTop": true,
    "editor.find.cursorMoveOnType": true,
    //
    // @@ Explorer & File Nesting
    //
    "explorer.autoRevealExclude": {
        "**/bower_components": true,
        "**/node_modules": true,
    },
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.decorations.badges": false,
    "explorer.confirmUndo": "default",
    "explorer.copyRelativePathSeparator": "auto",
    "explorer.enableDragAndDrop": true,
    "explorer.enableUndo": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "bootstrap.css": "bootstrap*",
        "composer.json": "composer.*",
        "*.css": "${capture}.min.css",
        "*.js": "${capture}.min.js, ${capture}.min.js.map, ${capture}.js.map",
        "*.json": "${capture}.min.json",
    },
    "explorer.fileNesting.expand": false,
    "explorer.incrementalNaming": "smart",
    "explorer.openEditors.minVisible": 0,
    "explorer.openEditors.visible": 4,
    "explorer.sortOrder": "foldersNestsFiles",
    //
    // @@ Window & Workbench
    //
    "breadcrumbs.showStructs": true,
    "breadcrumbs.icons": false,
    "window.title": "${activeRepositoryName}${separator}${activeEditorMedium}",
    "window.titleSeparator": " / ",
    "window.density.editorTabHeight": "compact",
    "workbench.iconTheme": "bearded-icons",
    "workbench.productIconTheme": "Default",
    "workbench.editor.doubleClickTabToToggleEditorGroupSizes": "maximize",
    "workbench.editor.decorations.badges": false,
    "workbench.editor.tabSizingFixedMinWidth": 100,
    "workbench.editor.tabSizingFixedMaxWidth": 100,
    "workbench.editor.titleScrollbarVisibility": "visible",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.untitled.labelFormat": "name",
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.scrollToSwitchTabs": false,
    "workbench.editor.sharedViewState": true,
    "workbench.editor.restoreViewState": false,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.limit.value": 8,
    "workbench.editor.limit.excludeDirty": true,
    "workbench.editor.autoLockGroups": {
        "imagePreview.previewEditor": true,
        "mainThreadWebview-markdown.preview": true,
        "vscode.audioPreview": true,
        "vscode.videoPreview": true,
        "workbench.editorinputs.searchEditorInput": true,
    },
    "workbench.editorAssociations": {
        "*.shyneko": "default",
        "*.sqlite3": "default",
        "*.bin": "default",
    },
    "workbench.editorLargeFileConfirmation": 64,
    "workbench.editor.useModal": "off",
    "workbench.startupEditor": "none",
    "workbench.reduceMotion": "auto",
    "workbench.settings.editor": "json",
    "workbench.settings.alwaysShowAdvancedSettings": true,
    "workbench.notifications.position": "top-right",
    "workbench.panel.opensMaximized": "preserve",
    "workbench.view.showQuietly": {
        "workbench.panel.output": true,
    },
    "workbench.list.mouseWheelScrollSensitivity": 2,
    "workbench.list.scrollByPage": false,
    "workbench.list.smoothScrolling": false,
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.stickyScrollMaxItemCount": 7,
    "workbench.editor.labelFormat": "short",
    "workbench.editor.centeredLayoutFixedWidth": true,
    "workbench.browser.dataStorage": "workspace",
    "workbench.browser.showInTitleBar": true,
    "workbench.browser.openLocalhostLinks": true,
    "workbench.activityBar.compact": true,
    "workbench.activityBar.iconClickBehavior": "focus",
    "workbench.activityBar.location": "top",
    "workbench.commandPalette.showAskInChat": false,
    "workbench.editor.alwaysShowEditorActions": true,
    "workbench.editor.navigationScope": "editor",
    "workbench.editor.openPositioning": "last",
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.tabActionCloseVisibility": false,
    "workbench.editor.tabActionLocation": "left",
    "workbench.editor.tabActionUnpinVisibility": false,
    "workbench.editor.tabSizing": "shrink",
    "workbench.hover.delay": 100,
    "workbench.hover.reducedDelay": 100,
    "workbench.sash.hoverDelay": 100,
    "workbench.reduceTransparency": "on",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.shadows": false,
    "workbench.tips.enabled": false,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.view.alwaysShowHeaderActions": true,
    "zenMode.showTabs": "none",
    "zenMode.silentNotifications": true,
    "zenMode.centerLayout": true,
    "workbench.colorTheme": "Bearded Theme feat. Will",
    "workbench.browser.sendElementsToChat.attachImages": false,
    "workbench.experimental.modernUIUppercaseViewHeaders": true,
    //
    // @@ Chat & GitHub Copilot
    //
    "chat.agent.sandbox.enabled": "off",
    "chat.agentHost.byokModels.enabled": true,
    "chat.byokUtilityModelDefault": "mainAgent",
    "chat.editor.wordWrap": "on",
    "chat.mcp.discovery.enabled": {
        "windsurf": true
    },
    "chat.mcp.gallery.enabled": true,
    "chat.tools.compressOutput.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "mv": true
    },
    "chat.unifiedAgentsBar.enabled": true,
    "chat.viewProgressBadge.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "jsonc": false
    },
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
    //
    // @@ Terminal
    //
    "terminal.explorerKind": "both",
    "terminal.integrated.fontFamily": "'Iosevka Neko Sans', 'CaskaydiaCove NF', 'Cascadia Code', 'Cascadia Mono', 'Fira Code', 'JetBrains Mono', 'monospace', monospace",
    "terminal.integrated.fontWeight": "400",
    "terminal.integrated.fontLigatures.featureSettings": "'liga','calt'",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 15.8,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.shellIntegration.decorationsEnabled": "overviewRuler",
    "terminal.integrated.scrollback": 2500,
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.mouseWheelScrollSensitivity": 2,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.allowChords": false,
    "terminal.integrated.hideOnStartup": "always",
    "terminal.integrated.altClickMovesCursor": false,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.suggest.quickSuggestions": {
        "commands": "on",
        "arguments": "on",
        "unknown": "off",
    },
    "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
    "terminal.integrated.rightClickBehavior": "default",
    "terminal.integrated.stickyScroll.maxLineCount": 2,
    "terminal.integrated.tabs.title": "${local}${separator}${process}",
    "terminal.integrated.tabs.defaultIcon": "terminal-linux",
    "terminal.integrated.tabs.defaultColor": "terminal.ansiMagenta",
    "terminal.integrated.tabs.separator": " ➤ ",
    "terminal.integrated.tabs.showActions": "always",
    "terminal.integrated.tabs.showActiveTerminal": "always",
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.terminal.findNext",
        "-search.action.focusNextSearchResult",
        "-workbench.action.debug.start",
    ],
    "terminal.integrated.profiles.linux": {
        "bash": {
            "icon": "terminal-bash",
            "path": "bash",
        },
        "fish": {
            "path": "fish",
        },
        "pwsh": {
            "icon": "terminal-powershell",
            "path": "pwsh",
        },
        "tmux": {
            "icon": "terminal-tmux",
            "path": "tmux",
        },
        "zsh": {
            "path": "zsh",
        },
    },
    //
    // @@ Git & SCM
    //
    "git.allowForcePush": true,
    "git.autofetch": true,
    "git.autorefresh": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.enableCommitSigning": false,
    "git.ignoreRebaseWarning": true,
    "git.inputValidation": true,
    "git.pruneOnFetch": true,
    "git.blame.statusBarItem.template": "${authorName} (${authorDateAgo}) ${subject}",
    "scm.repositories.visible": 3,
    "scm.diffDecorationsGutterWidth": 2,
    "scm.diffDecorationsGutterPattern": {
        "added": false,
        "modified": false,
    },
    //
    // @@ Debug & Console
    //
    "debug.toolBarLocation": "commandCenter",
    "debug.showBreakpointsInOverviewRuler": true,
    "debug.console.closeOnEnd": true,
    "debug.console.fontSize": 15.8,
    "debug.console.lineHeight": 1.618,
    "accessibility.verbosity.notebook": false,
    "diffEditor.maxComputationTime": 30000,
    "diffEditor.renderSideBySideInlineBreakpoint": 1000,
    "mergeEditor.diffAlgorithm": "advanced",
    "diffEditor.experimental.showMoves": true,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderIndicators": false,
    "editor.semanticHighlighting.enabled": true,
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "enumMember": {
                "italic": true,
            },
        },
    },
    //
    // @@ Language-Specific Settings
    //
    "[code-text-binary]": {
        "editor.wordWrap": "off",
        "editor.stopRenderingLineAfter": 58,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false,
        "editor.guides.indentation": false,
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            80
        ],
        "editor.selectionHighlight": false,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.suggestSelection": "first",
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off",
    },
    "[dockercompose]": {
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.suggestSelection": "first",
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "[markdown]": {
        "editor.rulers": [
            80
        ],
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 80,
    },
    "[nginx]": {
        "editor.defaultFormatter": "raynigon.nginx-formatter",
    },
    "[php]": {
        "editor.defaultFormatter": "lkrms.pretty-php",
        "editor.wordWrapColumn": 120,
        "editor.tabSize": 4,
        "editor.rulers": [
            120
        ],
    },
    "[python]": {
        "editor.rulers": [
            79
        ],
        "editor.tabSize": 4,
    },
    "[sql]": {
        "editor.defaultFormatter": "adpyke.vscode-sql-formatter",
    },
    "[xml]": {
        "editor.defaultFormatter": "mikeburgh.xml-format",
    },
    //
    // @@ Extensions and Plugins
    //
    // Extensions Settings
    //
    "extensions.closeExtensionDetailsOnViewChange": true,
    "extensions.allowOpenInModalEditor": false,
    "extensions.ignoreRecommendations": false,
    //
    // Intelephense
    //
    "intelephense.environment.phpVersion": "8.4.0",
    "intelephense.telemetry.enabled": false,
    "intelephense.codeLens.implementations.enable": true,
    "intelephense.codeLens.overrides.enable": true,
    "intelephense.codeLens.parent.enable": true,
    "intelephense.codeLens.references.enable": true,
    "intelephense.codeLens.usages.enable": true,
    "intelephense.completion.propertyCase": "camel",
    "intelephense.environment.documentRoot": "web",
    //
    // I18n Ally
    //
    "i18n-ally.displayLanguage": "en",
    "i18n-ally.theme.annotation": "rgba(153, 153, 153, 0.8)",
    "i18n-ally.theme.annotationBorder": "rgba(153, 153, 153, 0.08)",
    "i18n-ally.extract.keyMaxLength": 15,
    "i18n-ally.ignoredLocales": [],
    "i18n-ally.translate.deepl.useFreeApiEntry": true,
    "i18n-ally.translate.engines": [
        "deepl",
        "google"
    ],
    //
    // Todo Tree
    //
    "todo-tree.filtering.ignoreGitSubmodules": true,
    "todo-tree.general.statusBar": "total",
    "todo-tree.highlights.enabled": true,
    "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
    //
    // Bootstrap IntelliSense
    //
    "bootstrapIntelliSense": {
        "enable": true,
        "bsVersion": "5.3.7",
        "useLocalFile": false,
        "cssFilePath": "",
        "languageSupport": [
            "html",
            "php"
        ],
    },
    //
    // ErrorLens
    //
    "errorLens.fontWeight": "600",
    "errorLens.gutterIconsEnabled": false,
    "errorLens.padding": "70",
    "errorLens.delay": 500,
    //
    // HTML formatting
    //
    "html.format.enable": true,
    "html.format.templating": false,
    "html.format.wrapAttributes": "force-expand-multiline",
    //
    // Favorites extension
    //
    "favorites.storageFilePath": ".vscode/favorites.json",
    //
    // Problems
    //
    "problems.showCurrentInStatus": true,
    //
    // Redhat telemetry
    //
    "redhat.telemetry.enabled": true,
    //
    // Markdown
    //
    "markdown.occurrencesHighlight.enabled": true,
    //
    // JS/TS inlay hints
    //
    "js/ts.inlayHints.parameterNames.enabled": "all",
    "js/ts.inlayHints.parameterTypes.enabled": true,
    "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
    "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
    "js/ts.inlayHints.variableTypes.enabled": true,
    "js/ts.inlayHints.enumMemberValues.enabled": true,
    "js/ts.format.enabled": true,
    //
    // SFTP
    //
    "sftp.downloadWhenOpenInRemoteExplorer": true,
    "sftp.groupByHost": true,
    //
    // Screencast mode
    //
    "screencastMode.fontSize": 40,
    "screencastMode.keyboardOverlayTimeout": 1000,
    "screencastMode.verticalOffset": 0,
    "inlineChat.affordance": "off",
    // Breakpoint Enhancer
    "breakpointEnhancer.highlightColor": "rgba(255,128,0,0.2)",
    "breakpointEnhancer.textHighlightColor": "#FFFFFF",
    "breakpointEnhancer.indicatorSize": 0,
    // Active File In Status Bar
    "ActiveFileInStatusBar.revealFile": true,
    "ActiveFileInStatusBar.fullpath": false,
    // Color Highlight
    "color-highlight.markerType": "underline",
    "color-highlight.markRuler": false,
    "color-highlight.matchHslWithNoFunction": false,
    "color-highlight.matchRgbWithNoFunction": false,
    "color-highlight.matchWords": false,
    "color-highlight.useARGB": false,
    // Pretty PHP
    "pretty-php.formatting.blankBeforeReturn": true,
    "pretty-php.formatting.tightDeclarationSpacing": true,
    "pretty-php.formatting.alignment.alignTernaryOperators": true,
    "pretty-php.formatting.psr12": true,
    // VSCPlus
    "vscplus.statusBar.formatButton.triggers": [
        "onSave"
    ],
}
