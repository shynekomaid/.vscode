[
  {
    "key": "ctrl+alt+pagedown",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+alt+pageup",
    "command": "editor.action.copyLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+alt+q",
    "command": "revealFileInOS"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.terminal.focus",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenNavigatePrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenNavigateNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+alt+pausebreak",
    "command": "sftp.openConnectInTerminal"
  },
  {
    "key": "ctrl+enter",
    "command": "-github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "key": "ctrl+shift+insert",
    "command": "workbench.action.toggleLockedScrolling"
  },
  {
    "key": "shift+alt+f11",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "panelVisible"
  },
  {
    "key": "ctrl+alt+f",
    "command": "workbench.action.quickTextSearch"
  },
  {
    "key": "alt+j",
    "command": "cursorDown",
    "when": "textInputFocus"
  },
  {
    "key": "alt+k",
    "command": "cursorUp",
    "when": "textInputFocus"
  },
  {
    "key": "alt+h",
    "command": "cursorLeft",
    "when": "textInputFocus"
  },
  {
    "key": "alt+l",
    "command": "cursorRight",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+alt+d",
    "command": "sftp.diff.activeFile"
  },
  {
    "key": "ctrl+alt+s",
    "command": "sftp.upload.activeFile",
    "when": "sftp.enabled"
  },
  {
    "key": "ctrl+f6",
    "command": "git.commit",
    "when": "!operationInProgress"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.focusNextGroup"
  },
  {
    "key": "alt+e",
    "command": "cursorEnd",
    "when": "textInputFocus"
  },
  {
    "key": "alt+b",
    "command": "cursorHome",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+e",
    "command": "-editor.action.toggleScreenReaderAccessibilityMode",
    "when": "accessibilityHelpIsShown"
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+shift+e",
    "command": "workbench.action.createTerminalEditor",
    "when": "terminalProcessSupported"
  },
  {
    "key": "ctrl+alt+h",
    "command": "workbench.action.focusLeftGroup"
  },
  {
    "key": "ctrl+alt+l",
    "command": "workbench.action.focusRightGroup"
  },
  {
    "key": "ctrl+alt+k",
    "command": "workbench.action.focusAboveGroup"
  },
  {
    "key": "ctrl+alt+j",
    "command": "workbench.action.focusBelowGroup"
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpenNavigatePreviousInFilePicker",
    "when": "inFilesPicker && inQuickOpen"
  },
  {
    "key": "ctrl+shift+e",
    "command": "-workbench.action.quickOpenNavigatePreviousInFilePicker",
    "when": "inFilesPicker && inQuickOpen"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled"
  },
  {
    "key": "ctrl+shift+e",
    "command": "-workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled"
  },
  {
    "key": "ctrl+shift+f11",
    "command": "workbench.action.maximizeEditorHideSidebar",
    "when": "auxiliaryBarVisible || sideBarVisible || editorPartMultipleEditorGroups && !editorPartMaximizedEditorGroup"
  },
  {
    "key": "ctrl+k ctrl+alt+u",
    "command": "sftp.sync.localToRemote"
  }
]
